# ─────────────────────────────────────────────────────────────────────────────
# Sellonit — environment variables
#
#   cp .env.example .env
#
# The root .env is read by the api and worker dev scripts, by the integration
# test configs and by docker compose. apps/web is different — see its section.
# Never commit .env. Never put real secrets in this file.
# Blank values are treated as "not set".
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Local infrastructure (docker compose) ────────────────────────────────────
POSTGRES_USER=sellonit
# Local development only. Choose any value; it must match DATABASE_URL below.
POSTGRES_PASSWORD=sellonit_local_dev_only
POSTGRES_DB=sellonit
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Connections (api, worker) ────────────────────────────────────────────────
# Required in every environment. Inside docker compose the hosts are
# overridden to `postgres` / `redis` automatically.
DATABASE_URL=postgresql://sellonit:sellonit_local_dev_only@localhost:5432/sellonit?schema=public
REDIS_URL=redis://localhost:6379
# Redis key prefix for BullMQ queues (must match between api and worker).
QUEUE_PREFIX=sellonit

# ── API (apps/api) ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Number of trusted reverse-proxy hops for client IPs / rate limiting (0 = none).
API_TRUST_PROXY=0
API_BODY_LIMIT=1mb
API_SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated browser origins allowed by CORS.
# REQUIRED when NODE_ENV=production. Defaults to http://localhost:3000 otherwise.
CORS_ORIGINS=http://localhost:3000

# HS256 signing secret for access tokens (min 32 chars).
# REQUIRED when NODE_ENV=production. Generate with: openssl rand -base64 48
# If unset outside production, every authenticated endpoint answers 401 (fails closed).
JWT_ACCESS_SECRET=
JWT_ISSUER=sellonit-api
JWT_AUDIENCE=sellonit

# HMAC secrets for inbound webhooks (min 16 chars).
# REQUIRED when NODE_ENV=production. If unset, the webhook answers 503 (fails closed).
PAYMENT_WEBHOOK_SECRET=
THREE_PL_WEBHOOK_SECRET=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter per-IP limit for credential endpoints (login, register, OTP, reset).
AUTH_RATE_LIMIT_MAX=20

# ── Worker (apps/worker) ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
REDIS_CONNECT_TIMEOUT_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Next.js loads env from apps/web/.env* only. For local dev, either export these
# or copy them to apps/web/.env.local. Defaults work for a local setup.
#
# Server-side URL the Next.js server uses to reach the API (no /v1 suffix).
# Also used for the /api/v1/* proxy rewrite, which is fixed at BUILD time.
API_INTERNAL_URL=http://localhost:4000
# Browser-visible API base. Default: the same-origin proxy. Inlined at build time — never a secret.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Enable the /status diagnostics page (default: on outside production).
WEB_ENABLE_STATUS_PAGE=
# `next dev` only: extra hostnames allowed to load dev assets/HMR (comma-separated,
# wildcards allowed), e.g. when using a tunnel or remote preview: *.example.dev
WEB_ALLOWED_DEV_ORIGINS=
