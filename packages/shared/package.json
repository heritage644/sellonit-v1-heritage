{
  "name": "@sellonit/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe code shared by Sellonit apps, including the types generated from docs/openapi.yaml. Never add server-only code here.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
