{
  "name": "@sellonit/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Sellonit background job processor (BullMQ).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@sellonit/config": "*",
    "@sellonit/queue": "*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
